<Window x:Class="CP.ReactiveUI.Primitives.Windows.Example.TaskManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CP.ReactiveUI.Primitives.Windows.Example.TaskManager"
 Title="Windows • Task Manager" Width="1380" Height="900" MinWidth="950" MinHeight="650"
 Background="#10151F" Foreground="#E5ECF5">
 <Window.Resources>
  <local:ProcessAvailabilityConverter x:Key="ProcessAvailability"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5ECF5"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#18202E"/><Setter Property="Foreground" Value="#E5ECF5"/><Setter Property="RowBackground" Value="#18202E"/><Setter Property="AlternatingRowBackground" Value="#202A39"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ColumnWidth" Value="SizeToHeader"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2A3546"/><Setter Property="Foreground" Value="#C0CEE2"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E5ECF5"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#18202E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="#202A39"/><Setter Property="Foreground" Value="#D6E2F1"/><Setter Property="Padding" Value="15,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#35445A" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#263D43"/><Setter Property="Foreground" Value="#82EFE0"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#62D4C6"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#35445A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="8,0"/></Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
   <TextBlock Text="SYSTEM MONITOR" Foreground="#62D4C6" FontSize="12"/>
   <TextBlock Text="Task Manager" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock x:Name="CaptureStatus" Text="Connecting to Windows providers…" Foreground="#9CAEC8"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#202A39" Padding="12" Margin="0,12,0,0">
   <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ProviderStatus" Text="Read-only monitoring. Power settings change only when Apply is clicked." TextWrapping="Wrap" Foreground="#FFCC83"/></ScrollViewer>
  </Border>
  <TabControl>
   <TabItem Header="Overview">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#202A39" CornerRadius="8" Padding="20" Margin="0,0,8,12"><StackPanel>
       <TextBlock Text="CPU · TOTAL UTILIZATION" Foreground="#9CAEC8"/><TextBlock x:Name="CpuText" Text="Waiting for baseline" FontSize="32"/>
       <Canvas x:Name="CpuCanvas" Height="110" ClipToBounds="True" Background="#18202E"><Polyline x:Name="CpuLine" Stroke="#62D4C6" StrokeThickness="2"/></Canvas>
       <TextBlock Text="60 samples · fixed 0–100% scale" Foreground="#9CAEC8"/>
      </StackPanel></Border>
      <Border Grid.Column="1" Background="#202A39" CornerRadius="8" Padding="20" Margin="8,0,0,12"><StackPanel>
       <TextBlock Text="MEMORY · PHYSICAL USAGE" Foreground="#9CAEC8"/><TextBlock x:Name="MemoryText" Text="Waiting for provider" FontSize="32"/>
       <Canvas x:Name="MemoryCanvas" Height="110" ClipToBounds="True" Background="#18202E"><Polyline x:Name="MemoryLine" Stroke="#9F9AFF" StrokeThickness="2"/></Canvas>
       <TextBlock Text="60 samples · fixed 0–100% scale" Foreground="#9CAEC8"/>
      </StackPanel></Border>
     </Grid>
     <TextBlock Text="LOGICAL PROCESSORS" FontSize="16" Margin="0,10"/>
     <ItemsControl x:Name="CoreTiles"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Width="170" Margin="0,0,10,10" Padding="12" Background="#202A39" CornerRadius="6"><StackPanel>
       <TextBlock Text="{Binding Sample.InstanceName}" Foreground="#D6E2F1"/><TextBlock Text="{Binding Sample.Utilization.TotalPercent, StringFormat={}{0:F1} %, TargetNullValue=Baseline pending}" Foreground="#E5ECF5" FontSize="22"/>
       <Viewbox Height="45" Stretch="Fill"><Canvas Width="140" Height="110" ClipToBounds="True"><Polyline Points="{Binding History}" Stroke="#62D4C6" StrokeThickness="2"/></Canvas></Viewbox>
       <TextBlock Text="{Binding Sample.FrequencyMegahertz, StringFormat={}{0:F0} MHz, TargetNullValue=Frequency unavailable}" Foreground="#9CAEC8"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="MEMORY COUNTERS" FontSize="16" Margin="0,10"/>
     <TextBlock Text="{Binding Memory.Value.CommitTotalBytes, StringFormat=Committed bytes: {0:N0}}"/>
     <TextBlock Text="{Binding Memory.Value.SystemCacheBytes, StringFormat=System cache bytes: {0:N0}}"/>
     <TextBlock Text="{Binding Memory.Value.ProcessCount, StringFormat=Processes: {0:N0}}"/>
     <TextBlock Text="{Binding Memory.Value.ThreadCount, StringFormat=Threads: {0:N0}}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Processes"><DataGrid x:Name="ProcessTable" AutoGenerateColumns="False" RowHeight="32">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
     <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}"/>
     <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsagePercent, StringFormat=F1, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Memory bytes" Binding="{Binding WorkingSetBytes, StringFormat=N0, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Read B/s" Binding="{Binding ReadBytesPerSecond, StringFormat=N0, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Write B/s" Binding="{Binding WriteBytesPerSecond, StringFormat=N0, TargetNullValue=—}"/>
     <DataGridTextColumn Header="Priority" Binding="{Binding Priority, TargetNullValue=—}"/>
     <DataGridTemplateColumn Header="Availability" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Errors, Converter={StaticResource ProcessAvailability}}" ToolTip="{Binding Errors, Converter={StaticResource ProcessAvailability}, ConverterParameter=Details}" Foreground="#E5ECF5" TextWrapping="NoWrap" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid></TabItem>
   <TabItem Header="Hardware"><TabControl>
    <TabItem Header="CPU"><DataGrid ItemsSource="{Binding Hardware.Value.Processors}"/></TabItem>
    <TabItem Header="DIMMs"><DataGrid ItemsSource="{Binding Hardware.Value.MemoryModules}"/></TabItem>
    <TabItem Header="GPU"><DataGrid ItemsSource="{Binding Graphics.Value.Adapters}"/></TabItem>
    <TabItem Header="Storage"><DataGrid ItemsSource="{Binding Hardware.Value.Disks}"/></TabItem>
    <TabItem Header="OS"><DataGrid ItemsSource="{Binding Hardware.Value.OperatingSystems}"/></TabItem>
    <TabItem Header="Machine"><DataGrid ItemsSource="{Binding Hardware.Value.Machines}"/></TabItem>
    <TabItem Header="Thermals"><DataGrid ItemsSource="{Binding Thermals.Value.Sensors}"/></TabItem>
    <TabItem Header="Availability"><DataGrid ItemsSource="{Binding Hardware.Value.Queries}" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Query" Binding="{Binding Key}" Width="240"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Value.Status}" Width="140"/>
     <DataGridTextColumn Header="Reason" Binding="{Binding Value.Error}" Width="*"/>
    </DataGrid.Columns></DataGrid></TabItem>
   </TabControl></TabItem>
   <TabItem Header="GPU counters"><DataGrid ItemsSource="{Binding Graphics.Value.Counters}" AutoGenerateColumns="False"><DataGrid.Columns>
    <DataGridTextColumn Header="Instance" Binding="{Binding Counter.InstanceName}" Width="400"/>
    <DataGridTextColumn Header="Counter" Binding="{Binding Counter.CounterPath}" Width="300"/>
    <DataGridTextColumn Header="Value" Binding="{Binding Counter.Value, StringFormat=F1, TargetNullValue=Unavailable}"/>
    <DataGridTextColumn Header="Native status" Binding="{Binding Counter.Status}"/>
    <DataGridTextColumn Header="Adapter LUID" Binding="{Binding AdapterLuid}"/>
    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Network"><DataGrid ItemsSource="{Binding Network.Value.Interfaces}"/></TabItem>
   <TabItem Header="Services"><DataGrid ItemsSource="{Binding Services.Value.Services}"/></TabItem>
   <TabItem Header="Disks"><TabControl>
    <TabItem Header="Live I/O"><DataGrid ItemsSource="{Binding Storage.Value.PhysicalDisks}"/></TabItem>
    <TabItem Header="Volumes"><DataGrid ItemsSource="{Binding Storage.Value.Drives}"/></TabItem>
   </TabControl></TabItem>
   <TabItem Header="Power"><StackPanel Margin="16">
    <TextBlock Text="POWER &amp; BATTERY" FontSize="22"/>
    <TextBlock Text="{Binding Power.Value.Connection, StringFormat=Power connection: {0}}"/>
    <TextBlock Text="{Binding Power.Value.BatteryChargePercent, StringFormat=Battery: {0} %, TargetNullValue=Battery capacity unavailable}"/>
    <TextBlock Text="{Binding Power.Value.BatteryLifeRemaining, StringFormat=Time remaining: {0}, TargetNullValue=Battery runtime unavailable}"/>
    <TextBlock Text="{Binding Power.Value.IsEnergySaverEnabled, StringFormat=Energy saver: {0}}"/>
    <TextBlock Text="{Binding Power.Value.ActivePlanId, StringFormat=Active scheme: {0}}"/>
    <TextBlock Text="Choose a power plan, then Apply to activate it. This persists in Windows." Margin="0,30,0,12"/>
    <StackPanel Orientation="Horizontal"><ComboBox x:Name="PlanChooser" Width="320" DisplayMemberPath="FriendlyName"/><Button Content="Apply power plan" Click="ApplyPowerPlan"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=PlanChooser}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
    <TextBlock x:Name="PowerStatus" Text="Loading installed plans…" TextWrapping="Wrap"/>
   </StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
